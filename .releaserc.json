{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "type": "perf", "release": "patch" },
        { "type": "refactor", "release": "patch" },
        { "breaking": true, "release": "major" }
      ]
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits",
      "presetConfig": {
        "types": [
          { "type": "feat", "section": "Game" },
          { "type": "fix", "section": "Fixes" },
          { "type": "perf", "section": "Render and performance" },
          { "type": "refactor", "section": "Internals" },
          { "type": "test", "section": "Proof", "hidden": false },
          { "type": "build", "section": "Build and deploy", "hidden": false },
          { "type": "ci", "section": "Build and deploy", "hidden": false },
          { "type": "docs", "section": "Docs", "hidden": false },
          { "type": "chore", "hidden": true }
        ]
      }
    }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "package.json", "package-lock.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "successComment": false,
      "failComment": false
    }]
  ]
}

{
  "name": "replay",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "See the final score first, then bet on how the game got there.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "spike": "tsx scripts/sdk-spike.ts",
    "shipcheck": "node scripts/shipcheck.mjs",
    "bench": "tsx scripts/bench.ts",
    "gates": "tsx scripts/gates.ts",
    "prebuild": "tsx scripts/favicon.ts && tsx scripts/stamp-version.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "penpal": "^7.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}

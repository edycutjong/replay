{
  "name": "replay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "See the final score first, then bet on how the game got there.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "spike": "tsx scripts/sdk-spike.ts",
    "shipcheck": "node scripts/shipcheck.mjs",
    "bench": "tsx scripts/bench.ts",
    "gates": "tsx scripts/gates.ts",
    "prebuild": "tsx scripts/favicon.ts && tsx scripts/stamp-version.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "penpal": "^7.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.52.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "playwright": "^1.59.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
